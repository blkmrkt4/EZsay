## Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-connection-string

## Dev bypass — set to "true" locally to skip the auth + subscription gates
DEV_BYPASS_AUTH=false

## Stripe (test mode keys for dev, live keys for prod)
# From Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# From Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
# in dev, or from Stripe Dashboard → Webhooks endpoint signing secret in prod.
# Required for webhook signature verification.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe → Product catalog → click into each price row.
# Two products × two billing intervals = 4 IDs.
STRIPE_INDIVIDUAL_MONTHLY_PRICE_ID=price_...
STRIPE_INDIVIDUAL_ANNUAL_PRICE_ID=price_...
STRIPE_EAAS_MONTHLY_PRICE_ID=price_...
STRIPE_EAAS_ANNUAL_PRICE_ID=price_...

## OpenRouter (LLM routing)
# Falls back to admin_settings.openrouter_api_key if unset — admin panel
# is the canonical source. This env var is a dev escape hatch.
OPENROUTER_API_KEY=

## Tavily (web search for citation verification)
TAVILY_API_KEY=
